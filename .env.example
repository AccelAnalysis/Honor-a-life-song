# Application runtime
NEXT_PUBLIC_APP_ENV=development

# Firebase web app
# Project: Honor a Life Song (songify-cc2c5)
# The known non-secret project identifiers are prefilled below.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=songify-cc2c5
NEXT_PUBLIC_FIREBASE_APP_ID=1:471693809116:web:e13d6b10bd310bd78aeb19
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=471693809116

# Copy the exact remaining Firebase Web SDK values from
# Firebase Console > Project settings > Your apps into .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Optional. Populate only if Google Analytics is enabled for this Firebase app.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional Stripe Payment Links for organization experience checkout.
# A request is written first and its ID is sent as client_reference_id.
# Checkout return does not mark the request paid; Admin reconciliation remains authoritative.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_SINGLE_SONG_GROUP_EVENT=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_HONOR_A_LIFE_SONG_EXPERIENCE=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_SONGKEEP_LEGACY_ALBUM=

# Static GitHub Pages preview. Never use this to represent live transactions.
NEXT_PUBLIC_HALS_STATIC_PREVIEW=0

# Never place server/admin credentials in NEXT_PUBLIC_* variables.
# Keep privileged server credentials in local or deployment-managed secrets only.
